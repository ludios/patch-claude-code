#!/usr/bin/env python3
"""Patch the Claude Code VS Code extension so every monospace surface in its
chat follows the user's editor.fontFamily and editor.fontSize settings, so
its model picker offers a fixed lineup of models, so its input footer shows
how many tokens are in context, so a prompt stands out, is shown in full,
and scrolls with the rest of the chat instead of staying pinned to its top,
so its chat-font text is set in Inter Display, and the text of
assistant replies is restyled for easier reading, so its scrollbars look
like VS Code's own, so a Bash tool call's command wraps instead of being
cut off at the edge, so a chat's editor tab shows a spinning logo while
its session runs, and, on NixOS, so its native binary can run at all.

VS Code injects the real editor font into every webview as the
--vscode-editor-font-family / --vscode-editor-font-size (px) CSS variables,
but the extension overwrites both variables from the chat.editor.* settings
(defaults: "monospace" / 12px, i.e. Consolas at 12px on Windows), and several
surfaces hardcode their own sizes besides. This script patches:

  extension.js       - source that override (and its change listener) from
                       editor.* instead of chat.editor.*, making the two
                       variables trustworthy everywhere in the webview;
                       launch the CLI with MODEL_LINEUP as its model picker
                       and DEFAULT_MODEL as its default model, and put the
                       model rows it answers with in lineup order, name-only,
                       re-adding Mythos when the CLI hides it; give a chat
                       tab the RUNNING_ICON while its session is running
  resources/claude-logo-running.svg
                     - created: the plain logo, spinning
  webview/index.css  - point --monaco-monospace-font at the editor font, and
                       give each monospace rule whose own font-size is small
                       (under 14px, a fraction of an em, a percentage,
                       inherit, or the chat font size, possibly minus some
                       px) var(--vscode-editor-font-size) instead (tool
                       IN/OUT rows, header filenames, markdown inline code,
                       slash-command echoes, permission requests, pills, git
                       summaries, changed-file lists, MCP dialogs, ...);
                       also bring shrunken chat-font text (the
                       answered-AskUserQuestion review box, and the secondary
                       line under tool headers: "Answered · N questions",
                       "Added N lines", ...) back to the normal chat size;
                       set off prompts in the chat (in dark,
                       non-high-contrast themes, with a colored background
                       and near-white text); set the text that is in
                       the chat font in Inter Display instead, and the
                       text of assistant replies at a line height of 1.6
                       (in dark, non-high-contrast themes, a little
                       dimmer), with inline code in the same color and
                       with no background or padding; draw VS Code's
                       square scrollbars instead of Chrome's, as wide as
                       the editor's, and keep the fade at the bottom of
                       the chat off its scrollbar; wrap the command in a
                       Bash tool call's IN row
  webview/index.js   - pass the family variable into the embedded Monaco
                       diff editors (they already take their size from the
                       size variable); hide the model picker's Default row,
                       checking the row the default resolves to instead;
                       show the tokens in context (e.g. "152k") right of the
                       input footer's prompt-cache clock, and keep that count
                       through API errors; stop pinning each prompt to the
                       top of the chat while its turn scrolls by, and show
                       it in full instead of behind "Show more"
  resources/native-binary/claude
                     - on NixOS only: point its ELF interpreter at the
                       system's dynamic loader (taken from
                       /run/current-system/sw/bin/sh), since the FHS loader
                       it expects (e.g. /lib64/ld-linux-x86-64.so.2) does
                       not exist there

There is no load-time integrity check on these files (VS Code verifies
extension signatures only at install time), so editing them in place is
sufficient. The pristine originals are kept as .orig-font backups and re-read
as the input on every run, so re-running (even with newly added patterns) is
idempotent. Re-run after every extension update, then reload the VS Code
window; run with --undo to restore the originals and delete the created
files. The native binary gets no backup (it is ~300 MB) and --undo leaves
its interpreter alone, since the binary cannot run on NixOS without it.
Pass --no-mythos to leave Mythos out of the model lineup, for accounts
without access to it.

Usage: patch-claude-code [--undo] [--no-mythos]
"""

import json
import re
import subprocess
import sys
from pathlib import Path

EXTENSIONS_ROOT = Path.home() / ".vscode-server" / "extensions"
EXTENSION_GLOB  = "anthropic.claude-code-*"
BACKUP_SUFFIX   = ".orig-font"
NATIVE_BINARY   = "resources/native-binary/claude"
# Any system binary will do; its interpreter is the current glibc's loader.
NIXOS_LOADER_DONOR = "/run/current-system/sw/bin/sh"
# The file name of the tab icon this script adds to the extension's
# resources/, for a chat whose session is running.
RUNNING_ICON = "claude-logo-running.svg"

EDITOR_SIZE   = "var(--vscode-editor-font-size,12px)"
EDITOR_FAMILY = "var(--vscode-editor-font-family)"
# The font the chat's text is set in, ahead of the chat font: Inter Display,
# under both the name "InterDisplay" and its family name "Inter Display"
# (the only one of the two that Chrome on Linux matches).
TEXT_FONT = 'InterDisplay,"Inter Display"'
# A selector for assistant replies, and one (in an re.subn replacement
# string, with the markdown component's CSS-module hash as group 2) for the
# text in them.
REPLY      = "[data-testid=assistant-message]"
REPLY_TEXT = REPLY + r">.root_\2"
# The family variable, read at Monaco-editor construction time in JS.
MONACO_FONT_FAMILY = (
	'fontFamily:getComputedStyle(document.documentElement)'
	'.getPropertyValue("--vscode-editor-font-family").trim()||void 0'
)


# The chat font size variable, with or without a fallback value.
CHAT_SIZE = r"var\(--vscode-chat-font-size(?:,[^)]*)?\)"
# A font-size value that the webview uses for text no larger than its
# usual text: relative (em/%), sub-14px, inherit, or CHAT_SIZE, possibly
# minus some px. Larger sizes (14px and up for section titles and
# decorations, CHAT_SIZE plus some px) are deliberately left alone.
SMALL_SIZE = (
	r"(?:\.\d+em|(?:1[0-3]|[1-9])px|\d{1,2}(?:\.\d+)?%|inherit"
	r"|" + CHAT_SIZE + r"|calc\(" + CHAT_SIZE + r" - \d+px\))"
)
# A font-size declaration, not the end of a custom property's name such
# as --app-monospace-font-size.
FONT_SIZE = r"(?<![\w-])font-size:"
# The two custom properties the webview's monospace rules take their
# font-family from.
MONO_FAMILY = r"var\(--app-(?:monospace-font-family|font-family-mono)\)"

# The model picker's rows, in order, as (model ID, label).
MYTHOS = "claude-mythos-5-2"
MODEL_LINEUP = [
	(MYTHOS,             "Mythos 5.2"),
	("claude-fable-5-2", "Fable 5.2"),
	("claude-opus-5-5",  "Opus 5.5"),
	("claude-opus-4-8",  "Opus 4.8"),
	("claude-opus-4-6",  "Opus 4.6"),
]
# The model a session uses when no model is set, instead of the CLI's
# account-dependent default.
DEFAULT_MODEL = "claude-opus-5-5"
# {model ID: model ID} of lineup rows built when the CLI leaves them out,
# and the lineup row each copies its picker fields (supportedEffortLevels,
# supportsFastMode and the other supports* fields) from. For each pair,
# the CLI's model catalog gives both models the same values in those
# fields. The CLI hides Mythos whenever it lacks the server's model list.
STAND_INS = {MYTHOS: "claude-fable-5-2"}


def js_literal(value: object) -> str:
	"""Return `value` as a compact JSON (hence JS) literal that is also safe
	to use verbatim in an re.subn replacement string."""
	literal = json.dumps(value, separators=(",", ":"))
	assert "\\" not in literal, literal
	return literal


def cli_settings(lineup: list[tuple[str, str]]) -> str:
	"""Return, as a JS literal, the CLI settings that make DEFAULT_MODEL the
	default (an explicitly set model still wins) and whose modelPicker
	replaces the picker's built-in rows with `lineup`, (model ID, label)
	pairs in order. The CLI keeps its Default row in front of them, drops
	the rows the account can't use (and Mythos whenever it lacks the
	server's model list), appends the session's model when it is not among
	them, and describes each lineup row as "Custom model (<ID>)"."""
	options = [{"model": model, "label": label} for model, label in lineup]
	return js_literal({
		"env":         {"ANTHROPIC_DEFAULT_MODEL": DEFAULT_MODEL},
		"modelPicker": {"replaceBuiltInOptions": True, "options": options},
	})


def models_fixup(lineup: list[tuple[str, str]]) -> str:
	"""Return a JS function expression mapping the CLI's initialize response
	to one whose models are the Default row, then a row per `lineup` entry
	((model ID, label) pairs) in order, then any other rows the CLI added.
	Lineup rows get their label and no description, so the picker shows
	just their names. A lineup row the CLI left out is built from its
	STAND_INS row, unless the CLI listed it as unavailable."""
	stand_ins = {model: STAND_INS[model] for model, _ in lineup if model in STAND_INS}
	# Besides the lineup rows, the CLI lists only the Default row and the
	# session's model, so a stand-in copied from any other row would vanish.
	assert set(stand_ins.values()) <= {model for model, _ in lineup}, stand_ins
	return (
		"(r)=>{let m=r?.models;if(!Array.isArray(m))return r;"
		f"let L={js_literal(lineup)},S={js_literal(stand_ins)},u=r.unavailable_models??[],"
		'o=m.filter((x)=>x.value!=="default"),f=(id,rows)=>rows.find((x)=>x.resolvedModel===id);'
		'return{...r,models:[...m.filter((x)=>x.value==="default"),...L.flatMap(([id,label])=>{'
		"let x=f(id,o);"
		"if(!x){let t=S[id]&&!f(id,u)&&f(S[id],o);if(!t)return[];x={...t,value:id,resolvedModel:id}}"
		'return[{...x,displayName:label,description:""}]}),'
		"...o.filter((x)=>!L.some(([id])=>id===x.resolvedModel))]}}"
	)


def patterns(mythos: bool) -> dict[str, list[tuple[re.Pattern[str], str]]]:
	"""Return {relative file path: [(compiled regex, replacement)]} for one
	extension directory. Replacements are re.subn replacement strings.
	`mythos` says whether the model lineup includes Mythos."""
	lineup = [entry for entry in MODEL_LINEUP if mythos or entry[0] != MYTHOS]
	return {
		"webview/index.css": [
			# Every rule that uses the chat font (the page's, which the rest
			# of the text inherits, and those of buttons, menus and headers)
			# puts TEXT_FONT ahead of it.
			(re.compile(r"(?<![\w-])font-family:var\(--vscode-chat-font-family\)"),
			 "font-family:" + TEXT_FONT + ",var(--vscode-chat-font-family)"),
			# Monaco widget font (hovers, suggest details).
			(re.compile(r"--monaco-monospace-font:"),
			 "--monaco-monospace-font:" + EDITOR_FAMILY + ","),
			# The "small monospace" size (branch pills, changed-file lists,
			# git summaries) becomes the plain editor size.
			(re.compile(r"--app-monospace-font-size-small:[^;}]+"),
			 "--app-monospace-font-size-small:" + EDITOR_SIZE),
			# Sweep: any rule that combines the monospace family with a
			# smaller font-size gets the editor size instead, in both
			# declaration orders (family first, then size first).
			(re.compile("(" + MONO_FAMILY + r"[^}]*?)" + FONT_SIZE + SMALL_SIZE + r"(?=[;}])"),
			 r"\1font-size:" + EDITOR_SIZE),
			(re.compile(FONT_SIZE + SMALL_SIZE + r"(;[^}]*?" + MONO_FAMILY + r")"),
			 "font-size:" + EDITOR_SIZE + r"\1"),
			# The read-only "Answered · N questions" review reuses the
			# question prompt's .95em/.9em/.85em text, which is sized for
			# the prompt's 1.1em container but renders tiny inside a 1em
			# tool body. Append a rule giving the review's text the normal
			# chat size; the CSS-module hash is captured from the reviewBody
			# rule, since it changes between versions.
			(re.compile(r"(\.reviewBody_([\w-]+)\{[^}]*\})"),
			 r"\1.reviewBody_\2 :is(.questionTextLarge_\2,.optionLabel_\2,"
			 r".optionDescription_\2){font-size:1em}"),
			# The secondary line under tool headers ("Answered · N
			# questions", "Added N lines", tool descriptions, "Edit failed",
			# ...) is shrunk to .85em; give it the normal chat size.
			(re.compile(r"(\.secondaryLine_[\w-]+\{[^}]*?)font-size:[^;}]+"),
			 r"\1font-size:1em"),
			# Prompts in the chat share the input box's background; to make
			# them easier to spot among replies, give them a colored
			# background with near-white text in dark themes (VS Code marks
			# those with .vscode-dark; high-contrast ones get
			# .vscode-high-contrast instead), and elsewhere mix 10% of the
			# text color into their background.
			(re.compile(r"(\.userMessage_([\w-]+)\{[^}]*?background-color:)([^;}]+)([^}]*\})"),
			 r"\1color-mix(in srgb,\3,var(--app-primary-foreground) 10%)\4"
			 r".vscode-dark .userMessage_\2{background-color:#506195;color:hsla(0,0%,100%,.8)}"),
			# Restyle the text of assistant replies: the markdown component's
			# roots directly inside an assistant message (thinking, tool
			# output and dialogs render that component inside other
			# elements), found by the message's test ID, which every
			# supported version has (unlike its data-assistant-message
			# attribute, which is newer). The component's CSS-module hash is
			# captured from its inline-code rule. The text gets VS Code's
			# markdown preview's default line height of 1.6 (its code blocks
			# keep the chat's 1.5), and in dark, non-high-contrast themes, is
			# a little dimmer than the theme's text, unless the reply failed
			# (and so is in the theme's error color). Its inline code gets no
			# background, no padding (whose vertical part, at display scales
			# such as 125%, also drew the code a device pixel below the
			# text's baseline), and the color of the text around it instead
			# of the theme's color for preformatted text (yellow in dark
			# themes).
			(re.compile(r"(\.root_([\w-]+) code\{[^}]*var\(--app-inline-code-foreground\)[^}]*\})"),
			 r"\1"
			 + REPLY_TEXT + "{line-height:1.6}"
			 + REPLY_TEXT + " pre{line-height:1.5}"
			 + ".vscode-dark " + REPLY + r":not([class*=failedReply_])>.root_\2{color:#bbb}"
			 + REPLY_TEXT + " code{color:inherit;background:none;padding:0}"),
			# VS Code's webview host styles scrollbars with ::-webkit-scrollbar
			# rules (square, 10px wide, in its scrollbarSlider colors), but
			# also sets scrollbar-color on html, and Chrome ignores those
			# rules for any element with a scrollbar-color, drawing its own
			# scrollbars instead (on Linux: a rounded thumb, arrow buttons
			# and a colored track). Unset it, at the end of the file, so
			# that VS Code's scrollbars are drawn, and make vertical ones
			# 14px wide, the default width of the editor's. Elements that
			# set their own scrollbar-color or scrollbar-width keep Chrome's.
			(re.compile(r"\Z"),
			 "html{scrollbar-color:auto}::-webkit-scrollbar{width:14px}"),
			# The gradient that fades out the chat's bottom edge is an
			# overlay that also covers the chat's scrollbar. Chrome paints
			# an element's background under its scrollbar whatever its
			# background-clip, but with background-attachment local, only
			# inside its scrollport. So give the overlay a scrollbar of its
			# own: with nothing to scroll, it draws no thumb, and like the
			# chat's (VS Code's, see above), it is as wide and has no track.
			# The !important keeps the full-editor variant's background
			# shorthand from resetting the attachment.
			(re.compile(r"(\.messageGradient_[\w-]+\{)"),
			 r"\1overflow-y:scroll;background-attachment:local!important;"),
			# The IN row of a Bash tool call shows its command in a <pre>
			# that cuts off whatever doesn't fit on a line; wrap the
			# command's lines instead. (The row's cell still clips its
			# height, as it does for every tool row.)
			(re.compile(r"(\.inputRow_([\w-]+)\{[^}]*\})"),
			 r"\1.inputRow_\2 pre{white-space:pre-wrap}"),
		],
		"webview/index.js": [
			# The two embedded Monaco diff editors (chat diffs and previews).
			# Since 2.1.300 they size themselves from --app-monospace-font-size
			# (i.e. the editor size) and follow its changes, but still fall
			# back to Monaco's default family; add the editor family after
			# the fontSize option. Anchored on the createDiffEditor call
			# rather than neighbouring options, which change between versions.
			(re.compile(r'(createDiffEditor\([\w.]+,\{[^;]*?fontSize:[\w$]+\(\))(?=[,}])'),
			 r"\1," + MONACO_FONT_FAMILY),
			# The model picker component: leave the Default row out of its
			# rows, and when no model is set (current model "default"), check
			# the row the Default row resolves to (minus any 1M-context
			# suffix). The rest of the webview still finds the Default row,
			# to show the current model's name and effort levels.
			(re.compile(r"(availableModels:([\w$]+),unavailableModels:[\w$]+,currentModel:([\w$]+),[^;]*?\}\)\{)"
			            r"([^;]*?\[\.\.\.[\w$]+\()\2\?\?\[\]\)"),
			 r'\1let pccDefault=\2?.find((m)=>m.value==="default");'
			 r'if(\3==="default"&&pccDefault)'
			 r'\3=\2.find((m)=>m!==pccDefault&&m.resolvedModel===pccDefault.resolvedModel?.replace("[1m]",""))?.value??\3;'
			 r'\4(\2??[]).filter((m)=>m.value!=="default"))'),
			# Keep the session's context-usage count when a synthetic
			# assistant message (API error, notice) arrives: its usage is
			# all zeros, which would blank the count until the next response.
			(re.compile(r"if\(this\.updateUsage\(([\w$]+)\.message\.usage\),(\1\.message\.model!==[\w$]+)\)"),
			 r"if(\2&&this.updateUsage(\1.message.usage),\2)"),
			# Right of the input footer's prompt-cache clock ("60m"), show how
			# many tokens are in context, styled like the clock's text, with
			# the exact count on hover. It is the count behind the footer's
			# context pie (which appears only past 50% used), as of the last
			# main-thread response; 0, so hidden, in new and just-compacted
			# sessions. Like the clock's text, it is marked fixed-width and
			# re-created only when its length changes, so the footer re-fits
			# its items only then.
			(re.compile(r"(([\w$]+)\([\w$]+,\{usedTokens:([\w$]+)\.usageData\.value\.totalTokens,[^}]*?"
			            r"buttonClassName:([\w$]+)\.usageButtonV2\}\),\2\([\w$]+,\{session:\3\}\))"),
			 r'\1,((pccTokens,pccText=`${Math.round(pccTokens/1e3)}k`)=>pccTokens>0&&\2("span",{'
			 r'className:`${\4.footerButton} ${\4.footerButtonPrimary} ${\4.footerButtonStatic}`,'
			 r'title:`${pccTokens.toLocaleString()} tokens in context`,'
			 r'children:\2("span",{"data-footer-fixed-width":"",children:pccText},pccText.length)}))'
			 r'(\3.usageData.value.totalTokens)'),
			# Let each prompt scroll away with its turn: drop the
			# sticky-header class from its row (which also lifts the row's
			# 40vh height cap, and stops scrolling-into-view from leaving
			# room for the row) ...
			(re.compile(r'\$\{[\w$]+\?[\w$]+\.stickyHeader:""\}'),
			 ""),
			# ... and its click handler, which scrolls the chat back to where
			# the turn starts (for a prompt pinned while its turn scrolled by).
			(re.compile(r"return [\w$]+\?\{onMouseDownCapture:[\w$]+,onClick:[\w$]+\}:\{\}"),
			 "return{}"),
			# Prompts (and slash-command echoes) are cut to 60px behind a
			# "Show more" button by a component that collapses content taller
			# than its maxHeight; make every maxHeight infinite. The component
			# is found by the CSS-module map defined just before it.
			(re.compile(r'(expandableContainer:"expandableContainer_[\w-]+"[^}]*\};'
			            r"function [\w$]+\(\{children:[\w$]+,maxHeight:([\w$]+)=\d+\}\)\{)"),
			 r"\1\2=1/0;"),
		],
		"extension.js": [
			# Feed the webview override from editor.* instead of chat.editor.*
			# (covers notifyFontConfigurationChange and the inline-HTML
			# webview that re-declares the variables with !important) ...
			(re.compile(r'getConfiguration\("chat\.editor"\)'),
			 'getConfiguration("editor")'),
			# ... and re-point its configuration-change listener accordingly.
			(re.compile(r'affectsConfiguration\("chat\.(editor\.font(?:Size|Family|Weight))"\)'),
			 r'affectsConfiguration("\1")'),
			# Launch the chat's CLI with the model lineup as its picker and
			# DEFAULT_MODEL as its default. The SDK passes these as
			# --settings, which win over ~/.claude/settings.json's (but
			# leave its other env entries and keys alone). Only the chat's
			# options have a toolConfig, whereas their settingSources
			# changes between versions.
			(re.compile(r"(?=toolConfig:\{)"),
			 "settings:" + cli_settings(lineup) + ","),
			# Fix up the model rows in the SDK's initialize(), where every
			# model list the extension (and so the webview) sees comes from.
			# In the minified source, the statement that reads the response
			# directly follows the finally block that ends with
			# this.markInitializeWritten() (which runs only on the first
			# initialize(), but the read and so the fixup run on every one).
			(re.compile(r"(?<=this\.markInitializeWritten\(\)\})let ([\w$]+)=\(await ([\w$]+)\)\.response;"),
			 r"let \1=(" + models_fixup(lineup) + r")((await \2).response);"),
			# Give a chat's editor tab the RUNNING_ICON while its session is
			# running (as the webview reports it: busy, or with background
			# tasks). The function that picks the tab's icon returns
			# "pending" (a permission prompt or question waits), "done" (a
			# completion the user hasn't seen, never while running) or else
			# "plain"; make it return "running" instead of "plain" for a
			# running session ...
			(re.compile(r'(([\w$]+)\?\.state!=="running"\)return"done";)(?=return"plain")'),
			 r'\1if(\2?.state==="running")return"running";'),
			# ... and add that icon to its {icon name: file name} map.
			(re.compile(r'\{(?=pending:"claude-logo-pending\.svg")'),
			 '{running:"' + RUNNING_ICON + '",'),
		],
	}


# {relative path: (relative path of the extension file it is made from,
# [(compiled regex, replacement)])} for each file this script adds to an
# extension directory; each is made afresh on every run.
CREATED_FILES = {
	# The plain logo, turning once every 2 seconds about the center of its
	# 24x24 viewBox, where the logo is centered. VS Code draws a tab icon as
	# a CSS background image, which still plays SMIL animations.
	"resources/" + RUNNING_ICON: ("resources/claude-logo.svg", [
		(re.compile(r'(viewBox="0 0 24 24".*?<path\b[^>]*[^/]>)', re.DOTALL),
		 (r'\1<animateTransform attributeName="transform" type="rotate"'
		  r' from="0 12 12" to="360 12 12" dur="2s" repeatCount="indefinite"/>')),
	]),
}


def extension_dirs():
	"""Return matching extension directories, newest version last.
	Raises SystemExit when none exist."""
	def version_key(path):
		digits = re.findall(r"\d+", path.name)
		return [int(d) for d in digits]
	dirs = sorted(EXTENSIONS_ROOT.glob(EXTENSION_GLOB), key=version_key)
	if not dirs:
		sys.exit(f"no {EXTENSION_GLOB} directories under {EXTENSIONS_ROOT}")
	return dirs


def patchelf(*args: str | Path) -> str:
	"""Run patchelf and return its stripped stdout."""
	result = subprocess.run(["patchelf", *map(str, args)], check=True, stdout=subprocess.PIPE, text=True)
	return result.stdout.strip()


def nixos_interpreter() -> str | None:
	"""Return the dynamic loader that ELF binaries need on NixOS, or None
	when not running on NixOS."""
	if not Path("/etc/NIXOS").exists():
		return None
	return patchelf("--print-interpreter", NIXOS_LOADER_DONOR)


def patch_interpreter(path: Path, interpreter: str) -> bool:
	"""Set the ELF interpreter of the binary at `path` to the loader path
	`interpreter`, unless it already is, which saves rewriting the ~300 MB
	file. The patched copy is renamed over the original, so a running binary
	(which can't be opened for writing) gets patched too, and an interrupted
	run leaves no half-written binary. Re-running after a NixOS upgrade moves
	it to the new loader. Returns True when the interpreter ends up set."""
	if not path.is_file():
		print(f"  {path.name}: missing, skipped")
		return False
	current = patchelf("--print-interpreter", path)
	if current == interpreter:
		print(f"  {path.name}: interpreter already {interpreter}")
	else:
		patched = path.with_name(path.name + ".patching")
		patchelf("--set-interpreter", interpreter, "--output", patched, path)
		patched.replace(path)
		print(f"  {path.name}: interpreter {current} -> {interpreter}")
	return True


def apply_patterns(name: str, text: str, file_patterns: list[tuple[re.Pattern[str], str]]) -> tuple[str, bool]:
	"""Apply `file_patterns`, (compiled regex, re.subn replacement) pairs, in
	order to `text`, the contents of the file called `name` (for messages).
	Returns the result, and whether every pattern matched; prints a warning
	for each that did not (the signal that an extension update changed the
	code)."""
	ok = True
	for regex, replacement in file_patterns:
		text, count = regex.subn(replacement, text)
		if count == 0:
			print(f"  {name}: WARNING: no match for /{regex.pattern}/")
			ok = False
		else:
			print(f"  {name}: {count}x /{regex.pattern}/")
	return text, ok


def patch_file(path, file_patterns):
	"""Apply `file_patterns` to one file. The pristine original is kept at
	<name>.orig-font and is re-read as the input on every run. Returns True
	when every pattern matched."""
	if not path.is_file():
		print(f"  {path.name}: missing, skipped")
		return False
	backup = path.with_name(path.name + BACKUP_SUFFIX)
	if backup.exists():
		text = backup.read_text(encoding="utf-8")
	else:
		text = path.read_text(encoding="utf-8")
		backup.write_text(text, encoding="utf-8")
	text, ok = apply_patterns(path.name, text, file_patterns)
	path.write_text(text, encoding="utf-8")
	return ok


def create_file(path: Path, source: Path, file_patterns: list[tuple[re.Pattern[str], str]]) -> bool:
	"""Write the file `path`: the extension file `source` with
	`file_patterns` applied. Returns True when every pattern matched."""
	if not source.is_file():
		print(f"  {path.name}: its source {source.name} is missing, skipped")
		return False
	text, ok = apply_patterns(path.name, source.read_text(encoding="utf-8"), file_patterns)
	path.write_text(text, encoding="utf-8")
	return ok


def undo_dir(ext_dir):
	"""Restore every .orig-font backup under `ext_dir` and delete it, and
	delete the CREATED_FILES."""
	backups = list(ext_dir.rglob(f"*{BACKUP_SUFFIX}"))
	created = [ext_dir / rel for rel in CREATED_FILES if (ext_dir / rel).exists()]
	if not backups and not created:
		print("  nothing to undo")
	for backup in backups:
		original = backup.with_name(backup.name.removesuffix(BACKUP_SUFFIX))
		original.write_bytes(backup.read_bytes())
		backup.unlink()
		print(f"  restored {original.name}")
	for path in created:
		path.unlink()
		print(f"  deleted {path.name}")


def main() -> None:
	args = sys.argv[1:]
	if not set(args) <= {"--undo", "--no-mythos"}:
		sys.exit("usage: patch-claude-code [--undo] [--no-mythos]")
	undo   = "--undo" in args
	mythos = "--no-mythos" not in args

	dirs = extension_dirs()
	interpreter = None if undo else nixos_interpreter()
	newest_ok = False
	for ext_dir in dirs:
		print(f"{ext_dir.name}:")
		if undo:
			undo_dir(ext_dir)
			continue
		results = [
			patch_file(ext_dir / rel, file_patterns)
			for rel, file_patterns in patterns(mythos).items()
		] + [
			create_file(ext_dir / rel, ext_dir / source, file_patterns)
			for rel, (source, file_patterns) in CREATED_FILES.items()
		]
		if interpreter:
			results.append(patch_interpreter(ext_dir / NATIVE_BINARY, interpreter))
		if ext_dir is dirs[-1]:
			newest_ok = all(results)
	if not undo:
		if newest_ok:
			print(f"done: patched {dirs[-1].name}; reload the VS Code window")
		else:
			sys.exit(f"FAILED to fully patch the newest version, {dirs[-1].name}")


if __name__ == "__main__":
	main()
