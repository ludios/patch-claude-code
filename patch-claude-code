#!/usr/bin/env python3
# Model-output: Claude Fable 5
# Model-output: Claude Opus 5.5
"""Patch the Claude Code VS Code extension so every monospace surface in its
chat follows the user's editor.fontFamily and editor.fontSize settings, so
its model picker offers a fixed lineup of models, and, on NixOS, so its
native binary can run at all.

VS Code injects the real editor font into every webview as the
--vscode-editor-font-family / --vscode-editor-font-size (px) CSS variables,
but the extension overwrites both variables from the chat.editor.* settings
(defaults: "monospace" / 12px, i.e. Consolas at 12px on Windows), and several
surfaces hardcode their own sizes besides. This script patches:

  extension.js       - source that override (and its change listener) from
                       editor.* instead of chat.editor.*, making the two
                       variables trustworthy everywhere in the webview;
                       launch the CLI with MODEL_LINEUP as its model picker
                       and DEFAULT_MODEL as its default model, and put the
                       model rows it answers with in lineup order, name-only,
                       re-adding Mythos when the CLI hides it
  webview/index.css  - point --monaco-monospace-font at the editor font, and
                       give every monospace rule with a smaller hardcoded size
                       (tool IN/OUT rows, header filenames, markdown inline
                       code, slash-command echoes, permission requests, pills,
                       git summaries, ...) var(--vscode-editor-font-size);
                       also bring shrunken chat-font text (the
                       answered-AskUserQuestion review box, and the secondary
                       line under tool headers: "Answered · N questions",
                       "Added N lines", ...) back to the normal chat size
  webview/index.js   - pass the family variable into the embedded Monaco
                       diff editors (they already take their size from the
                       size variable); hide the model picker's Default row,
                       checking the row the default resolves to instead
  resources/native-binary/claude
                     - on NixOS only: point its ELF interpreter at the
                       system's dynamic loader (taken from
                       /run/current-system/sw/bin/sh), since the FHS loader
                       it expects (e.g. /lib64/ld-linux-x86-64.so.2) does
                       not exist there

There is no load-time integrity check on these files (VS Code verifies
extension signatures only at install time), so editing them in place is
sufficient. The pristine originals are kept as .orig-font backups and re-read
as the input on every run, so re-running (even with newly added patterns) is
idempotent. Re-run after every extension update, then reload the VS Code
window; run with --undo to restore the originals. The native binary gets no
backup (it is ~300 MB) and --undo leaves its interpreter alone, since the
binary cannot run on NixOS without it. Pass --no-mythos to leave Mythos out
of the model lineup, for accounts without access to it.

Usage: patch-claude-code [--undo] [--no-mythos]
"""

import json
import re
import subprocess
import sys
from pathlib import Path

EXTENSIONS_ROOT = Path.home() / ".vscode-server" / "extensions"
EXTENSION_GLOB  = "anthropic.claude-code-*"
BACKUP_SUFFIX   = ".orig-font"
NATIVE_BINARY   = "resources/native-binary/claude"
# Any system binary will do; its interpreter is the current glibc's loader.
NIXOS_LOADER_DONOR = "/run/current-system/sw/bin/sh"

EDITOR_SIZE   = "var(--vscode-editor-font-size,12px)"
EDITOR_FAMILY = "var(--vscode-editor-font-family)"
# The family variable, read at Monaco-editor construction time in JS.
MONACO_FONT_FAMILY = (
	'fontFamily:getComputedStyle(document.documentElement)'
	'.getPropertyValue("--vscode-editor-font-family").trim()||void 0'
)


# A font-size value smaller than a typical editor font: relative (em/%),
# sub-14px, or inherit. Larger fixed sizes (section titles, decorations)
# are deliberately left alone.
SMALL_SIZE = r"(?:\.\d+em|(?:1[0-3]|[1-9])px|\d{1,2}(?:\.\d+)?%|inherit)"
# The two custom properties the webview's monospace rules take their
# font-family from.
MONO_FAMILY = r"var\(--app-(?:monospace-font-family|font-family-mono)\)"

# The model picker's rows, in order, as (model ID, label).
MYTHOS = "claude-mythos-5-1"
MODEL_LINEUP = [
	(MYTHOS,             "Mythos 5.1"),
	("claude-fable-5-1", "Fable 5.1"),
	("claude-fable-5",   "Fable 5"),
	("claude-opus-5-5",  "Opus 5.5"),
	("claude-opus-4-8",  "Opus 4.8"),
	("claude-opus-4-6",  "Opus 4.6"),
]
# The model a session uses when no model is set, instead of the CLI's
# account-dependent default.
DEFAULT_MODEL = "claude-opus-5-5"
# {model ID: model ID} of lineup rows built when the CLI leaves them out,
# and the row each copies its capabilities (effort levels, adaptive
# thinking, no fast mode, ...) from; the CLI's model catalog gives each
# pair the same ones. The CLI hides Mythos whenever it lacks the server's
# model list.
STAND_INS = {MYTHOS: "claude-fable-5-1"}


def js_literal(value: object) -> str:
	"""Return `value` as a compact JSON (hence JS) literal that is also safe
	to use verbatim in an re.subn replacement string."""
	literal = json.dumps(value, separators=(",", ":"))
	assert "\\" not in literal, literal
	return literal


def cli_settings(lineup: list[tuple[str, str]]) -> str:
	"""Return, as a JS literal, the CLI settings that make DEFAULT_MODEL the
	default (an explicitly set model still wins) and whose modelPicker
	replaces the picker's built-in rows with `lineup`, (model ID, label)
	pairs in order. The CLI keeps its Default row in front of them, drops
	the rows the account can't use (and Mythos whenever it lacks the
	server's model list), appends the session's model when it is not among
	them, and describes each lineup row as "Custom model (<ID>)"."""
	options = [{"model": model, "label": label} for model, label in lineup]
	return js_literal({
		"env":         {"ANTHROPIC_DEFAULT_MODEL": DEFAULT_MODEL},
		"modelPicker": {"replaceBuiltInOptions": True, "options": options},
	})


def models_fixup(lineup: list[tuple[str, str]]) -> str:
	"""Return a JS function expression mapping the CLI's initialize response
	to one whose models are the Default row, then a row per `lineup` entry
	((model ID, label) pairs) in order, then any other rows the CLI added.
	Lineup rows get their label and no description, so the picker shows
	just their names. A lineup row the CLI left out is built from its
	STAND_INS row, unless the CLI listed it as unavailable."""
	stand_ins = {model: STAND_INS[model] for model, _ in lineup if model in STAND_INS}
	return (
		"(r)=>{let m=r?.models;if(!Array.isArray(m))return r;"
		f"let L={js_literal(lineup)},S={js_literal(stand_ins)},u=r.unavailable_models??[],"
		'o=m.filter((x)=>x.value!=="default"),f=(id,rows)=>rows.find((x)=>x.resolvedModel===id);'
		'return{...r,models:[...m.filter((x)=>x.value==="default"),...L.flatMap(([id,label])=>{'
		"let x=f(id,o);"
		"if(!x){let t=S[id]&&!f(id,u)&&f(S[id],o);if(!t)return[];x={...t,value:id,resolvedModel:id}}"
		'return[{...x,displayName:label,description:""}]}),'
		"...o.filter((x)=>!L.some(([id])=>id===x.resolvedModel))]}}"
	)


def patterns(mythos: bool) -> dict[str, list[tuple[re.Pattern[str], str]]]:
	"""Return {relative file path: [(compiled regex, replacement)]} for one
	extension directory. Replacements are re.subn replacement strings.
	`mythos` says whether the model lineup includes Mythos."""
	lineup = [entry for entry in MODEL_LINEUP if mythos or entry[0] != MYTHOS]
	return {
		"webview/index.css": [
			# Monaco widget font (hovers, suggest details).
			(re.compile(r"--monaco-monospace-font:"),
			 "--monaco-monospace-font:" + EDITOR_FAMILY + ","),
			# The "small monospace" size (branch pills, changed-file lists,
			# git summaries) becomes the plain editor size.
			(re.compile(r"--app-monospace-font-size-small:[^;}]+"),
			 "--app-monospace-font-size-small:" + EDITOR_SIZE),
			# Sweep: any rule that combines the monospace family with a
			# smaller font-size gets the editor size instead, in both
			# declaration orders (family first, then size first).
			(re.compile("(" + MONO_FAMILY + r"[^}]*?)font-size:" + SMALL_SIZE + r"(?=[;}])"),
			 r"\1font-size:" + EDITOR_SIZE),
			(re.compile(r"font-size:" + SMALL_SIZE + r"(;[^}]*?" + MONO_FAMILY + r")"),
			 "font-size:" + EDITOR_SIZE + r"\1"),
			# The read-only "Answered · N questions" review reuses the
			# question prompt's .95em/.9em/.85em text, which is sized for
			# the prompt's 1.1em container but renders tiny inside a 1em
			# tool body. Append a rule giving the review's text the normal
			# chat size; the CSS-module hash is captured from the reviewBody
			# rule, since it changes between versions.
			(re.compile(r"(\.reviewBody_([\w-]+)\{[^}]*\})"),
			 r"\1.reviewBody_\2 :is(.questionTextLarge_\2,.optionLabel_\2,"
			 r".optionDescription_\2){font-size:1em}"),
			# The secondary line under tool headers ("Answered · N
			# questions", "Added N lines", tool descriptions, "Edit failed",
			# ...) is shrunk to .85em; give it the normal chat size.
			(re.compile(r"(\.secondaryLine_[\w-]+\{[^}]*?)font-size:[^;}]+"),
			 r"\1font-size:1em"),
		],
		"webview/index.js": [
			# The two embedded Monaco diff editors (chat diffs and previews).
			# Since 2.1.300 they size themselves from --app-monospace-font-size
			# (i.e. the editor size) and follow its changes, but still fall
			# back to Monaco's default family; add the editor family after
			# the fontSize option. Anchored on the createDiffEditor call
			# rather than neighbouring options, which change between versions.
			(re.compile(r'(createDiffEditor\([\w.]+,\{[^;]*?fontSize:[\w$]+\(\))(?=[,}])'),
			 r"\1," + MONACO_FONT_FAMILY),
			# The model picker component: leave the Default row out of its
			# rows, and when no model is set (current model "default"), check
			# the row the Default row resolves to (minus any 1M-context
			# suffix). The rest of the webview still finds the Default row,
			# to show the current model's name and effort levels.
			(re.compile(r"(availableModels:([\w$]+),unavailableModels:[\w$]+,currentModel:([\w$]+),[^;]*?\}\)\{)"
			            r"([^;]*?\[\.\.\.[\w$]+\()\2\?\?\[\]\)"),
			 r'\1let pccDefault=\2?.find((m)=>m.value==="default");'
			 r'if(\3==="default"&&pccDefault)'
			 r'\3=\2.find((m)=>m!==pccDefault&&m.resolvedModel===pccDefault.resolvedModel?.replace("[1m]",""))?.value??\3;'
			 r'\4(\2??[]).filter((m)=>m.value!=="default"))'),
		],
		"extension.js": [
			# Feed the webview override from editor.* instead of chat.editor.*
			# (covers notifyFontConfigurationChange and the inline-HTML
			# webview that re-declares the variables with !important) ...
			(re.compile(r'getConfiguration\("chat\.editor"\)'),
			 'getConfiguration("editor")'),
			# ... and re-point its configuration-change listener accordingly.
			(re.compile(r'affectsConfiguration\("chat\.(editor\.font(?:Size|Family|Weight))"\)'),
			 r'affectsConfiguration("\1")'),
			# Launch the chat's CLI with the model lineup as its picker and
			# DEFAULT_MODEL as its default. The SDK passes these as
			# --settings, which win over ~/.claude/settings.json's (but
			# leave its other env entries and keys alone).
			(re.compile(r'(?=settingSources:\["user","project","local"\],toolConfig:)'),
			 "settings:" + cli_settings(lineup) + ","),
			# Fix up the model rows in the SDK's initialize(), where every
			# model list the extension (and so the webview) sees comes from.
			(re.compile(r"let ([\w$]+)=\(await ([\w$]+)\)\.response;(?=if\(this\.initConfig)"),
			 r"let \1=(" + models_fixup(lineup) + r")((await \2).response);"),
		],
	}


def extension_dirs():
	"""Return matching extension directories, newest version last.
	Raises SystemExit when none exist."""
	def version_key(path):
		digits = re.findall(r"\d+", path.name)
		return [int(d) for d in digits]
	dirs = sorted(EXTENSIONS_ROOT.glob(EXTENSION_GLOB), key=version_key)
	if not dirs:
		sys.exit(f"no {EXTENSION_GLOB} directories under {EXTENSIONS_ROOT}")
	return dirs


def patchelf(*args: str | Path) -> str:
	"""Run patchelf and return its stripped stdout."""
	result = subprocess.run(["patchelf", *map(str, args)], check=True, stdout=subprocess.PIPE, text=True)
	return result.stdout.strip()


def nixos_interpreter() -> str | None:
	"""Return the dynamic loader that ELF binaries need on NixOS, or None
	when not running on NixOS."""
	if not Path("/etc/NIXOS").exists():
		return None
	return patchelf("--print-interpreter", NIXOS_LOADER_DONOR)


def patch_interpreter(path: Path, interpreter: str) -> bool:
	"""Set the ELF interpreter of the binary at `path` to the loader path
	`interpreter`, unless it already is, which saves rewriting the ~300 MB
	file. The patched copy is renamed over the original, so a running binary
	(which can't be opened for writing) gets patched too, and an interrupted
	run leaves no half-written binary. Re-running after a NixOS upgrade moves
	it to the new loader. Returns True when the interpreter ends up set."""
	if not path.is_file():
		print(f"  {path.name}: missing, skipped")
		return False
	current = patchelf("--print-interpreter", path)
	if current == interpreter:
		print(f"  {path.name}: interpreter already {interpreter}")
	else:
		patched = path.with_name(path.name + ".patching")
		patchelf("--set-interpreter", interpreter, "--output", patched, path)
		patched.replace(path)
		print(f"  {path.name}: interpreter {current} -> {interpreter}")
	return True


def patch_file(path, file_patterns):
	"""Apply `file_patterns` to one file. The pristine original is kept at
	<name>.orig-font and is re-read as the input on every run. Returns True
	when every pattern matched; prints a warning for each that did not (the
	signal that an extension update changed the minified code)."""
	if not path.is_file():
		print(f"  {path.name}: missing, skipped")
		return False
	backup = path.with_name(path.name + BACKUP_SUFFIX)
	if backup.exists():
		text = backup.read_text(encoding="utf-8")
	else:
		text = path.read_text(encoding="utf-8")
		backup.write_text(text, encoding="utf-8")
	ok = True
	for regex, replacement in file_patterns:
		text, count = regex.subn(replacement, text)
		if count == 0:
			print(f"  {path.name}: WARNING: no match for /{regex.pattern}/")
			ok = False
		else:
			print(f"  {path.name}: {count}x /{regex.pattern}/")
	path.write_text(text, encoding="utf-8")
	return ok


def undo_dir(ext_dir):
	"""Restore every .orig-font backup under `ext_dir` and delete it."""
	backups = list(ext_dir.rglob(f"*{BACKUP_SUFFIX}"))
	if not backups:
		print("  nothing to undo")
	for backup in backups:
		original = backup.with_name(backup.name.removesuffix(BACKUP_SUFFIX))
		original.write_bytes(backup.read_bytes())
		backup.unlink()
		print(f"  restored {original.name}")


def main() -> None:
	args = sys.argv[1:]
	if not set(args) <= {"--undo", "--no-mythos"}:
		sys.exit("usage: patch-claude-code [--undo] [--no-mythos]")
	undo   = "--undo" in args
	mythos = "--no-mythos" not in args

	dirs = extension_dirs()
	interpreter = None if undo else nixos_interpreter()
	newest_ok = False
	for ext_dir in dirs:
		print(f"{ext_dir.name}:")
		if undo:
			undo_dir(ext_dir)
			continue
		results = [
			patch_file(ext_dir / rel, file_patterns)
			for rel, file_patterns in patterns(mythos).items()
		]
		if interpreter:
			results.append(patch_interpreter(ext_dir / NATIVE_BINARY, interpreter))
		if ext_dir is dirs[-1]:
			newest_ok = all(results)
	if not undo:
		if newest_ok:
			print(f"done: patched {dirs[-1].name}; reload the VS Code window")
		else:
			sys.exit(f"FAILED to fully patch the newest version, {dirs[-1].name}")


if __name__ == "__main__":
	main()
