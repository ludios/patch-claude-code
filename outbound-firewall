#!/usr/bin/env python3
# Model-output: Claude Opus 5.5
r"""Claude Code PreToolUse hook: make the user confirm any tool call that could
reach the network and carries one of their private strings (name, email, ...).

The strings live one per line in a config file kept outside this repo
(default ~/.config/claude-outbound-firewall/blocked-strings); anything after
a # is a comment. Only letters and digits are compared, ignoring case and
accents, in both the raw and the percent-decoded text, so "Ada+Lovelace",
'ada\ lovelace', "ada-lovelace" and "ada%40example.org" all match. Each
string needs at least MIN_ENTRY letters and digits, lest it match unrelated
text.

All the strings and numbers in the tool call's input are checked as one
text, so a name split across fields ({"first": "Ada", "last": "Lovelace"})
still matches. So is the start of any file an argument names by absolute
path, as upload tools take.

This inspects what Claude asks a tool to do, not the bytes that leave the
machine: a Bash command that reads a string from a file at run time, or
encodes it, gets through. The tools in LOCAL_TOOLS are not inspected, since
they stay on this machine.

On a match the hook answers "ask", so the user gets a permission prompt; in a
`claude -p` run nobody can answer it, so the call is refused. A missing or
empty config asks too, and with "onFailure": "block" a crash or timeout
blocks the call, so the firewall never silently fails open.

Install by adding to ~/.claude/settings.json:

	"hooks": {"PreToolUse": [{"matcher": "*", "hooks": [{"type": "command",
		"command": "/path/to/outbound-firewall", "onFailure": "block"}]}]}

Usage: outbound-firewall [CONFIG]   (reads the hook's JSON input on stdin)
"""

import json
import re
import sys
import unicodedata
from collections.abc import Iterator
from pathlib import Path
from urllib.parse import unquote_plus

DEFAULT_CONFIG = Path.home() / ".config" / "claude-outbound-firewall" / "blocked-strings"
LOCAL_TOOLS    = frozenset({
	"Read", "Edit", "Write", "NotebookEdit", "Grep", "Glob", "LSP", "AskUserQuestion", "ToolSearch",
	"TodoWrite", "TaskCreate", "TaskUpdate", "TaskStop", "EnterPlanMode", "ExitPlanMode",
})
MIN_ENTRY      = 6          # letters and digits a blocked string needs
MAX_FILE       = 1_000_000  # bytes to read from a file an argument names
NOT_COMPARED   = re.compile(r"[\W_]+")


def normalize(text: str) -> str:
	"""Return just the letters and digits of `text`, casefolded, without accents."""
	return NOT_COMPARED.sub("", unicodedata.normalize("NFKD", text).casefold())


def load_blocked(path: Path) -> dict[str, str]:
	"""Read the config at `path`.

	Returns a map from each blocked string's normalized form to the string as
	written in the config.
	"""
	blocked = {}
	for line in path.read_text(encoding="utf-8-sig").splitlines():
		entry = line.partition("#")[0].strip()
		if not entry:
			continue
		key = normalize(entry)
		if len(key) < MIN_ENTRY:
			raise ValueError(f"{entry!r} has fewer than {MIN_ENTRY} letters and digits, so it would match unrelated text")
		blocked[key] = entry
	if not blocked:
		raise ValueError("it lists no strings")
	return blocked


def strings_in(value: object, keys: bool = False) -> Iterator[str]:
	"""Yield every string and number in the JSON value `value` or, if `keys`,
	every object key in it instead."""
	if isinstance(value, str) and not keys:
		yield value
	elif isinstance(value, (int, float)) and not isinstance(value, bool) and not keys:
		yield str(value)
	elif isinstance(value, dict):
		for key, item in value.items():
			if keys:
				yield key
			yield from strings_in(item, keys)
	elif isinstance(value, list):
		for item in value:
			yield from strings_in(item, keys)


def file_start(arg: str) -> str | None:
	"""Return the first MAX_FILE bytes, as text, of the file `arg` names by
	absolute path, or None if `arg` names no readable file."""
	if not arg.startswith(("/", "~/")) or "\n" in arg:
		return None
	path = Path(arg).expanduser()
	try:
		if not path.is_file():  # nor a FIFO or device, which could block or never end
			return None
		with path.open("rb") as f:
			return f.read(MAX_FILE).decode("utf-8", "replace")
	except (OSError, ValueError):
		return None


def first_blocked(tool_input: object, blocked: dict[str, str]) -> str | None:
	"""Return the first blocked string (as written in the config) found in
	`tool_input`, or None if there is none.

	`blocked` maps normalized forms to strings as written, as load_blocked
	returns.
	"""
	args  = [*strings_in(tool_input), *strings_in(tool_input, keys=True)]
	text  = "\x00".join(args + [content for content in map(file_start, args) if content is not None])
	forms = (normalize(text), normalize(unquote_plus(text)))
	for key, entry in blocked.items():
		if any(key in form for form in forms):
			return entry
	return None


def ask(reason: str) -> None:
	"""Tell Claude Code to show the user a permission prompt giving `reason`."""
	json.dump({"hookSpecificOutput": {
		"hookEventName":            "PreToolUse",
		"permissionDecision":       "ask",
		"permissionDecisionReason": reason,
	}}, sys.stdout)


def main() -> None:
	"""Check the tool call described on stdin against the config named by the
	first argument, or DEFAULT_CONFIG."""
	config = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_CONFIG
	event  = json.load(sys.stdin)
	assert event["hook_event_name"] == "PreToolUse", f"wired to {event['hook_event_name']}, not PreToolUse"
	tool = event["tool_name"]
	if tool in LOCAL_TOOLS:
		return

	try:
		blocked = load_blocked(config)
	except (OSError, ValueError) as e:
		ask(f"outbound-firewall can't use its config {config}: {e}")
		return
	entry = first_blocked(event["tool_input"], blocked)
	if entry is not None:
		ask(f"outbound-firewall: this {tool} call contains {entry!r}, one of the strings it blocks")


if __name__ == "__main__":
	main()
